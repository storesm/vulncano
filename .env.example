# copy to .env, both docker compose and the manual path read it

# sqlite needs no server, this is the default
VULNCANO_DATABASE_URL=sqlite:////data/vulncano.db
# mysql or mariadb instead
# VULNCANO_DATABASE_URL=mysql+pymysql://vulncano:vulncano@db:3306/vulncano

# where uploads, raw scanner output and rendered reports are kept
VULNCANO_DATA_DIR=/data

# required before any scanner credential can be saved
# generate with: python -c "import secrets;print(secrets.token_urlsafe(32))"
VULNCANO_SECRET_KEY=

# single user auth, off by default so a laptop install just works
VULNCANO_AUTH_ENABLED=false
VULNCANO_AUTH_USER=admin
VULNCANO_AUTH_PASSWORD=

# raises the NVD lookup limit from 5 requests per 30s to 50
VULNCANO_NVD_API_KEY=

# where the frontend dev server runs
VULNCANO_CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# drop your own report templates here, they win over the packaged ones
# VULNCANO_REPORT_TEMPLATES_DIR=/data/templates

MYSQL_ROOT_PASSWORD=vulncano
MYSQL_DATABASE=vulncano
MYSQL_USER=vulncano
MYSQL_PASSWORD=vulncano
